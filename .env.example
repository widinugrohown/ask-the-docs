# Copy this file to .env and fill it in. Never commit .env.
# The whole pipeline is configured from these values; no provider is named in the source code.

# --- LLM (any OpenAI-compatible endpoint) ---
LLM_BASE_URL=https://ollama.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-v4.1-flash

# --- Embeddings: local, CPU, 384 dimensions ---
EMBED_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# --- Vector store ---
CHROMA_PATH=data/chroma

# --- Public demo gate (only used by main.py when DEMO_PASSWORD is set) ---
# Leave DEMO_PASSWORD empty to run with no password locally.
DEMO_PASSWORD=
DEMO_SECRET=
